APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Bahia

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# -----------------------------------------------------------------------------
# Uploads / midia (IMPORTANTE para Railway/Docker)
# -----------------------------------------------------------------------------
# Container local eh efemero: uploads em storage/app/public somem ao redeploy se
# FILESYSTEM_DISK=public sem volume persistente. Em producao use S3-compativel:
# AWS S3 ou Cloudflare R2 (endpoint proprio).
#
# Local: mantenha public + rode "php artisan storage:link"
FILESYSTEM_DISK=public
# Opcional: sobrescreve apenas uploads de produtos/logo/serviços/fotos (senão usa FILESYSTEM_DISK).
# FILESYSTEM_MEDIA_DISK=s3
#
# Producao (ex. Railway): FILESYSTEM_DISK=s3 na maioria dos casos.
# Preencha AWS_* abaixo. AWS_URL = URL publica do bucket/CDN (Custom Domain R2 ou r2.dev) para <img src>.
#
# Cloudflare R2 usa em geral:
# AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# Para R2: endpoint da API S3; para AWS S3 padrao pode ficar vazio.
AWS_ENDPOINT=
# URL publica dos arquivos (dominio R2 public, Custom Domain ou CloudFront).
AWS_URL=
# R2: em geral true. AWS S3 padrao (virtual-hosted) pode precisar false.
AWS_USE_PATH_STYLE_ENDPOINT=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/agendar/google/callback"

MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_OAUTH_REDIRECT_URI="${APP_URL}/company/payment-integrations/mercado-pago/callback"
MERCADO_PAGO_API_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_AUTH_BASE_URL=https://auth.mercadopago.com.br

BOOKING_MIN_LEAD_TIME_MINUTES=10

VITE_APP_NAME="${APP_NAME}"
